WEBUI_PORT=65003
TZ=Europe/Berlin
ISHIKU_LOG_LEVEL=info
# Required, at least 32 random characters, e.g. `openssl rand -base64 32`.
ISHIKU_SETUP_SECRET=replace-with-at-least-32-random-characters
MEIKU_ACCESS_LOG=false
# Set to true only when Meiku is reachable exclusively through one reverse proxy
# that appends the client address to X-Forwarded-For.
MEIKU_TRUST_PROXY=false
# ZimaOS default:
MEIKU_DATA_PATH=/DATA/AppData/meiku/data
# Docker Desktop local testing alternative:
# MEIKU_DATA_PATH=./data
